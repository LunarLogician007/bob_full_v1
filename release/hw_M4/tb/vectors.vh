endtask

task run_ce_sr;
begin
    ce_sr_step(6'b000000, 3'b000);
    ce_sr_step(6'b000001, 3'b001);
    ce_sr_step(6'b000011, 3'b000);
    ce_sr_step(6'b000001, 3'b001);
    ce_sr_step(6'b000000, 3'b001);
    ce_sr_step(6'b000010, 3'b000);
    ce_sr_step(6'b000001, 3'b001);
    ce_sr_step(6'b000000, 3'b001);
end
endtask

task init_cnt_seq;
begin
    cnt_state[0] = 4'b0000; cnt_pad[0] = 3'b000;
    cnt_state[1] = 4'b0001; cnt_pad[1] = 3'b000;
    cnt_state[2] = 4'b0010; cnt_pad[2] = 3'b001;
    cnt_state[3] = 4'b0011; cnt_pad[3] = 3'b001;
    cnt_state[4] = 4'b0100; cnt_pad[4] = 3'b010;
    cnt_state[5] = 4'b0101; cnt_pad[5] = 3'b010;
    cnt_state[6] = 4'b0110; cnt_pad[6] = 3'b011;
    cnt_state[7] = 4'b0111; cnt_pad[7] = 3'b011;
    cnt_state[8] = 4'b1000; cnt_pad[8] = 3'b100;
    cnt_state[9] = 4'b1001; cnt_pad[9] = 3'b100;
    cnt_state[10] = 4'b1010; cnt_pad[10] = 3'b101;
    cnt_state[11] = 4'b1011; cnt_pad[11] = 3'b101;
    cnt_state[12] = 4'b1100; cnt_pad[12] = 3'b110;
    cnt_state[13] = 4'b1101; cnt_pad[13] = 3'b110;
    cnt_state[14] = 4'b1110; cnt_pad[14] = 3'b111;
    cnt_state[15] = 4'b1111; cnt_pad[15] = 3'b111;
end
endtask

