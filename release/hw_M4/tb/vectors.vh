// chain round trip: a random pattern whose routing muxes all select an
// out-of-range source (20..31 reads const 0), so committing it cannot build a
// combinational loop - a fully random chain can, and a zero-delay oscillation
// hangs the simulator (it did at M4).
`define RT_WORD 3064'
`define RT_CRC 32'haae4d430
// one registered tile, INIT 1, D 0 (designs.d_gsr_probe)
`define GSR_WORD 3064'
`define GSR_CRC 32'h940efdce
// showcase, and a corrupted 'three' chain carrying its true CRC
`define SHOW_WORD 3064'
`define SHOW_CRC 32'h6f7cbd67
`define BAD_WORD 3064'
`define BAD_CRC 32'ha4b842cd
// M4: routed CE/SR; 4-bit carry-chain counter, JTAG-stepped and free-running
`define CE_SR_WORD 3064'
`define CE_SR_CRC 32'h1225afad
`define CNTJ_WORD 3064'
`define CNTJ_CRC 32'h034349ef
`define CNTR_WORD 3064'
`define CNTR_CRC 32'haf6a86ef

