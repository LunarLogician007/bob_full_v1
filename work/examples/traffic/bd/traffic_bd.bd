   "params": {},
   "x": 980,
   "y": 190
  },
  {
   "id": "night",
   "kind": "module",
   "type": "night_flash",
   "params": {},
   "x": 740,
   "y": 400
  },
  {
   "id": "lamp",
   "kind": "ip",
   "type": "mux2",
   "params": {
    "W": 3
   },
   "x": 1220,
   "y": 260
  }
 ],
 "wires": [
  {
   "src": "slow.tick",
   "dst": "rate.a"
  },
  {
   "src": "fast.tick",
   "dst": "rate.b"
  },
  {
   "src": "board.SW1",
   "dst": "rate.sel"
  },
  {
   "src": "rate.y",
   "dst": "timer.tick"
  },
  {
   "src": "rate.y",
   "dst": "night.tick"
  },
  {
   "src": "board.BTN0",
   "dst": "walk_btn.d"
  },
  {
   "src": "walk_btn.q",
   "dst": "ctrl.walk"
  },
  {
   "src": "timer.left",
   "dst": "ctrl.left"
  },
  {
   "src": "ctrl.load",
   "dst": "timer.load"
  },
  {
   "src": "ctrl.len",
   "dst": "timer.len"
  },
  {
   "src": "board.SW0",
   "dst": "ctrl.night"
  },
  {
   "src": "ctrl.lamps",
   "dst": "lamp.a"
  },
  {
   "src": "night.lamps",
   "dst": "lamp.b"
  },
  {
   "src": "board.SW0",
   "dst": "lamp.sel"
  },
  {
   "src": "lamp.y",
   "dst": "board.led"
  }
 ],
 "board": {
  "ix": 20,
  "iy": 230,
  "ox": 1460,
  "oy": 280,
  "in_pins": [
