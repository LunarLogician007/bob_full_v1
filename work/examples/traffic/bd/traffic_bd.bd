   },
   "x": 500,
   "y": 50
  },
  {
   "id": "walk_btn",
   "kind": "ip",
   "type": "debounce",
   "params": {
    "N": 1
   },
   "x": 260,
   "y": 330
  },
  {
   "id": "timer",
   "kind": "module",
   "type": "phase_timer",
   "params": {},
   "x": 740,
   "y": 50
  },
  {
   "id": "ctrl",
   "kind": "module",
